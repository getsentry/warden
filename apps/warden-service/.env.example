# Connected automatically when Neon is added through Vercel Marketplace.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
WARDEN_SERVICE_DATABASE_DRIVER=neon
WARDEN_SERVICE_DATABASE_MAX_CONNECTIONS=3
WARDEN_SERVICE_DATABASE_STATEMENT_TIMEOUT_MS=15000

# Generate independent random values. Do not reuse a Warden service token.
WARDEN_SERVICE_SESSION_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-16-random-characters

# Google OAuth is enabled by default. Use the stable production origin here.
DISABLE_AUTH=false
WARDEN_SERVICE_BASE_URL=https://warden.example.com
WARDEN_SERVICE_TENANT_ID=00000000-0000-4000-8000-000000000000
WARDEN_SERVICE_GOOGLE_DOMAIN=sentry.io
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Local or private deployments may explicitly bypass browser auth.
# DISABLE_AUTH=true
