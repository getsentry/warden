{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["api/**/*.ts", "examples/**/*.ts", "src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", ".vercel"]
}
