---
type BenchmarkScoring = {
  knownFindingCount: number;
  knownFound: number;
  knownFoundRate: number;
  knownMissed: number;
};

type BenchmarkResult = {
  corpusId: string;
  model: string;
  repository: string;
  runId: string;
  runtime: string;
  scoring?: BenchmarkScoring;
  shardCount: number;
  skill: string;
  summary: {
    costUSD: number;
    findingsTotal: number;
  };
  targetMode: string;
};

const resultModules = import.meta.glob<BenchmarkResult>(
  "../data/benchmarking/results/*.json",
  {eager: true, import: "default"},
);

const results = Object.values(resultModules)
  .filter(
    (result) =>
      result.corpusId === "sentry-vulnerability-corpus" &&
      result.targetMode === "all-corpus-files-by-sha",
  )
  .sort((a, b) => {
    const aRate = a.scoring?.knownFoundRate ?? -1;
    const bRate = b.scoring?.knownFoundRate ?? -1;
    if (aRate !== bRate) {
      return bRate - aRate;
    }
    return a.model.localeCompare(b.model);
  });

const runDate = (runId: string) => {
  const match = runId.match(/\d{4}-\d{2}-\d{2}/);
  return match?.[0] ?? "unknown";
};

const formatCost = (value: number) => `$${value.toFixed(2)}`;

const formatPercent = (value: number) => `${(value * 100).toFixed(1)}%`;

const resultPath = (result: BenchmarkResult) =>
  `https://github.com/getsentry/warden/blob/main/packages/docs/src/data/benchmarking/results/${result.runId}.json`;

const modelLabel = (model: string) => {
  if (model === "openai/gpt-5.5") {
    return "GPT 5.5";
  }
  if (model === "anthropic/claude-sonnet-4-6") {
    return "Claude Sonnet 4.6";
  }
  if (model === "claude-sonnet-4-6") {
    return "Claude Sonnet 4.6";
  }
  if (model === "anthropic/claude-opus-4-8") {
    return "Claude Opus 4.8";
  }
  if (model === "claude-opus-4-8") {
    return "Claude Opus 4.8";
  }
  return model;
};

const runtimeLabel = (runtime: string) => {
  if (runtime === "claude") {
    return "Claude SDK";
  }
  if (runtime === "pi") {
    return "Pi";
  }
  return runtime;
};

const skillLabel = (skill: string) =>
  skill.replace("@sentry/warden:", "").replace(/@\d.+$/, "");
---

<section class="benchmark-runs" aria-label="Latest benchmark runs">
  {results.length === 0 ? (
    <p>No benchmark runs recorded yet.</p>
  ) : (
    <table class="run-table">
      <thead>
        <tr>
          <th scope="col">Run</th>
          <th scope="col">Known</th>
          <th scope="col">Findings</th>
          <th scope="col">Cost</th>
        </tr>
      </thead>
      {results.map((result) => {
        const scoring = result.scoring;
        return (
          <tbody class="run-group">
            <tr class="run-row">
              <td class="run-name">
                <h3>{modelLabel(result.model)} · {runtimeLabel(result.runtime)}</h3>
              </td>
              <td class="run-cell">
                <span class="cell-label">Known corpus</span>
                <strong>
                  {scoring
                    ? `${scoring.knownFound}/${scoring.knownFindingCount}`
                    : "Not scored"}
                </strong>
                {scoring && <span>{formatPercent(scoring.knownFoundRate)}</span>}
              </td>
              <td class="run-cell">
                <span class="cell-label">Total findings</span>
                <strong>{result.summary.findingsTotal}</strong>
              </td>
              <td class="run-cell">
                <span class="cell-label">Cost</span>
                <strong>{formatCost(result.summary.costUSD)}</strong>
              </td>
            </tr>
            <tr class="run-meta-row">
              <td colspan="4">
                {result.model} · {runDate(result.runId)} · {skillLabel(result.skill)} ·{" "}
                <a href={resultPath(result)}>JSON</a>
              </td>
            </tr>
          </tbody>
        );
      })}
    </table>
  )}
</section>

<style>
  .benchmark-runs {
    margin: 1rem 0 1.5rem;
  }

  .run-table {
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 8px;
    border-spacing: 0;
    overflow: hidden;
    width: 100%;
  }

  .run-table th,
  .run-table td {
    min-width: 0;
    padding: 0.55rem 0.7rem;
    text-align: left;
    vertical-align: top;
  }

  .run-table thead {
    background: color-mix(in srgb, var(--sl-color-gray-6) 58%, transparent);
  }

  .run-table th {
    color: var(--sl-color-gray-3);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .run-table th:first-child,
  .run-name {
    width: 52%;
  }

  .run-table th:not(:first-child),
  .run-cell {
    width: 16%;
  }

  .run-group .run-row > td {
    border-top: 1px solid var(--sl-color-gray-6);
    padding-bottom: 0.1rem;
  }

  .run-group:first-of-type .run-row > td {
    border-top: 0;
  }

  .run-meta-row td {
    color: var(--sl-color-gray-3);
    font-size: 0.76rem;
    padding-top: 0;
  }

  .run-name h3 {
    color: var(--sl-color-white);
    font-size: 0.94rem;
    line-height: 1.3;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .run-cell span,
  .cell-label {
    color: var(--sl-color-gray-3);
    font-size: 0.76rem;
  }

  .run-cell strong {
    color: var(--sl-color-white);
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .cell-label {
    display: none;
  }

  @media (max-width: 58rem) {
    .run-table thead {
      display: none;
    }

    .run-table,
    .run-group,
    .run-row,
    .run-row > td,
    .run-meta-row,
    .run-meta-row > td {
      display: block;
      width: auto;
    }

    .run-row {
      padding: 0.85rem 0.85rem 0;
    }

    .run-group {
      border-top: 1px solid var(--sl-color-gray-6);
    }

    .run-group:first-of-type {
      border-top: 0;
    }

    .run-group .run-row > td {
      border-top: 0;
    }

    .run-row > td {
      padding: 0;
    }

    .run-row > .run-cell {
      display: inline-grid;
      margin: 0.65rem 0.9rem 0 0;
      min-width: 6rem;
    }

    .run-meta-row td {
      padding: 0.35rem 0.85rem 0.85rem;
    }

    .cell-label {
      display: inline;
    }
  }
</style>
