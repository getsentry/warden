---
type BenchmarkScoring = {
  knownFindingCount: number;
  knownFound: number;
  knownFoundRate: number;
  knownMissed: number;
};

type BenchmarkResult = {
  corpusId: string;
  model: string;
  runId: string;
  runtime: string;
  scoring?: BenchmarkScoring;
  skill: string;
  summary: {
    costUSD: number;
    findingsTotal: number;
  };
  targetMode: string;
};

const resultModules = import.meta.glob<BenchmarkResult>(
  "../data/benchmarking/results/*.json",
  {eager: true, import: "default"},
);

const results = Object.values(resultModules)
  .filter(
    (result) =>
      result.corpusId === "sentry-vulnerability-corpus" &&
      result.targetMode === "all-corpus-files-by-sha",
  )
  .sort((a, b) => {
    const aRate = a.scoring?.knownFoundRate ?? -1;
    const bRate = b.scoring?.knownFoundRate ?? -1;
    if (aRate !== bRate) {
      return bRate - aRate;
    }
    return a.model.localeCompare(b.model);
  });

const runDate = (runId: string) => {
  const match = runId.match(/\d{4}-\d{2}-\d{2}/);
  return match?.[0] ?? "unknown";
};

const formatCost = (value: number) => `$${value.toFixed(2)}`;

const formatPercent = (value: number) => `${(value * 100).toFixed(1)}%`;

const resultPath = (result: BenchmarkResult) =>
  `https://github.com/getsentry/warden/blob/main/packages/docs/src/data/benchmarking/results/${result.runId}.json`;

const modelLabel = (model: string) => {
  if (model === "openai/gpt-5.5") {
    return "GPT 5.5";
  }
  if (model === "anthropic/claude-sonnet-4-6") {
    return "Claude Sonnet 4.6";
  }
  if (model === "claude-sonnet-4-6") {
    return "Claude Sonnet 4.6";
  }
  if (model === "anthropic/claude-opus-4-8") {
    return "Claude Opus 4.8";
  }
  if (model === "claude-opus-4-8") {
    return "Claude Opus 4.8";
  }
  return model;
};

const runtimeLabel = (runtime: string) => {
  if (runtime === "claude") {
    return "Claude SDK";
  }
  if (runtime === "pi") {
    return "Pi";
  }
  return runtime;
};

const skillLabel = (skill: string) =>
  skill.replace("@sentry/warden:", "").replace(/@\d.+$/, "");
---

<section class="benchmark-runs" aria-label="Latest benchmark runs">
  {results.length === 0 ? (
    <p>No benchmark runs recorded yet.</p>
  ) : (
    <div class="run-table" role="table" aria-label="Latest benchmark runs">
      <div class="run-header" role="row">
        <span role="columnheader">Run</span>
        <span role="columnheader">Known</span>
        <span role="columnheader">Findings</span>
        <span role="columnheader">Cost</span>
      </div>
      {results.map((result) => {
        const scoring = result.scoring;
        return (
          <article class="run-row" role="row">
            <div class="run-name" role="cell">
              <h3>
                {modelLabel(result.model)}{" "}
                <span>({runtimeLabel(result.runtime)})</span>
              </h3>
              <p>
                {runDate(result.runId)} · {skillLabel(result.skill)} ·{" "}
                <a href={resultPath(result)}>JSON</a>
              </p>
            </div>
            <div class="metric-cell" role="cell">
              <span class="cell-label">Known corpus</span>
              <strong class="metric-value">
                {scoring
                  ? `${scoring.knownFound}/${scoring.knownFindingCount}`
                  : "Not scored"}
              </strong>
              {scoring && <span class="metric-detail">{formatPercent(scoring.knownFoundRate)}</span>}
            </div>
            <div class="metric-cell" role="cell">
              <span class="cell-label">Total findings</span>
              <strong class="metric-value">{result.summary.findingsTotal}</strong>
            </div>
            <div class="metric-cell" role="cell">
              <span class="cell-label">Cost</span>
              <strong class="metric-value">{formatCost(result.summary.costUSD)}</strong>
            </div>
          </article>
        );
      })}
    </div>
  )}
</section>

<style>
  .benchmark-runs {
    margin: 1rem 0 1.5rem;
  }

  .run-table {
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 8px;
    overflow: hidden;
    width: 100%;
  }

  .run-header,
  .run-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) repeat(3, 80px);
  }

  .run-header {
    background: color-mix(in srgb, var(--sl-color-gray-6) 58%, transparent);
    color: var(--sl-color-gray-3);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .run-header > *,
  .run-row > * {
    align-self: start;
    margin-top: 0;
    min-width: 0;
    padding: 0.55rem 0.7rem;
    vertical-align: top;
  }

  .run-header > :not(:first-child) {
    text-align: center;
    white-space: nowrap;
  }

  .run-row {
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .run-row:first-of-type {
    border-top: 0;
  }

  .run-name {
    display: grid;
    gap: 0.12rem;
  }

  .metric-cell {
    display: grid;
    gap: 0.12rem;
    justify-items: center;
    text-align: center;
    white-space: nowrap;
  }

  .run-name h3,
  .run-name p {
    margin: 0;
  }

  .run-name h3 {
    color: var(--sl-color-white);
    font-size: 0.94rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .run-name h3 span {
    color: var(--sl-color-gray-3);
    font-weight: 500;
  }

  .run-name p,
  .metric-detail,
  .cell-label {
    color: var(--sl-color-gray-3);
    font-size: 0.76rem;
  }

  .metric-value {
    color: var(--sl-color-white);
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.35;
    text-align: center;
    white-space: nowrap;
  }

  .cell-label {
    display: none;
  }

  @media (max-width: 38rem) {
    .run-header {
      display: none;
    }

    .run-row {
      display: block;
      padding: 0.85rem;
    }

    .run-row {
      border-top: 1px solid var(--sl-color-gray-6);
    }

    .run-row:first-child {
      border-top: 0;
    }

    .run-row > * {
      padding: 0;
    }

    .metric-cell {
      display: inline-grid;
      justify-items: start;
      margin: 0.65rem 0.9rem 0 0;
      min-width: 6rem;
      text-align: left;
    }

    .metric-value {
      text-align: left;
    }

    .cell-label {
      display: inline;
    }
  }
</style>
